# ─── Copy to .env on the VPS (never commit real .env) ─────────────────────────
#   cp .env.example .env
#   then fill in real values, or scp your local .env to the server.
#
# MongoDB Atlas (required). Allow the VPS IP in Atlas → Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/resume-builder?retryWrites=true&w=majority

# Or standard Atlas host list form (also fine):
# MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/resume-builder?ssl=true&replicaSet=...&authSource=admin

JWT_SECRET=change-me-to-a-long-random-string

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEVORA21_API_KEY=
DEVORA21_SCRAPE_URL=https://api.devora21.com/jobs/scrape

CHROMIUM_PATH=/usr/bin/chromium-browser

B2_BUCKET=tiger-builder
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APP_KEY=

NODE_ENV=production
