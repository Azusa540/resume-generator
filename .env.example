# MongoDB connection URI
MONGODB_URI=mongodb://mongodb:27017/resume-builder

# JWT secret for session tokens (change this in production!)
JWT_SECRET=your-secure-jwt-secret-here

# OpenAI API Key (if used)
OPENAI_API_KEY=sk-...

# Anthropic API Key (required for resume generation)
ANTHROPIC_API_KEY=sk-ant-...

# Devora21 Job Scraping API Key (required for /api/resume/generate-from-link)
DEVORA21_API_KEY=dv21_...

# Devora21 Scrape Endpoint URL
DEVORA21_SCRAPE_URL=https://api.devora21.com/jobs/scrape

# Optional: Path to Chromium executable (for Puppeteer PDF generation)
# Leave empty to auto-detect
CHROMIUM_PATH=

# Backblaze B2 (S3-compatible) — generated resume PDFs
# Endpoint/region MUST match the bucket's S3 endpoint from the B2 console
# (or s3ApiUrl from b2_authorize_account). Wrong region → InvalidAccessKeyId.
B2_BUCKET=your-bucket-name
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APP_KEY=

# Node environment (production or development)
NODE_ENV=production
